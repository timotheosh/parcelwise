# Parcelwise environment configuration (spec section 12: "Provide a
# checked-in example environment file containing names but no values").
# Copy this file to `.env` (or otherwise supply these values to the
# application's environment) and fill in real values locally. Never commit
# `.env` or any file containing a real SHIPPO_API_TOKEN.

# Which carrier provider to use: "fake" (deterministic, no network calls,
# the default when unset) or "shippo" (spec section 8.2).
CARRIER_PROVIDER=

# Shippo TEST-mode API token (spec section 8.2). Required only when
# CARRIER_PROVIDER=shippo; the application fails fast at startup with a
# secret-free message if it is missing. Never use a live/production Shippo
# token (spec section 4: "Do not implement ... Production Shippo
# credentials").
SHIPPO_API_TOKEN=
