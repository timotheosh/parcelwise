        <mxCell id="prov_eb6" value=":provider :shippo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="prov_adapterfactory" target="prov_shippocarrier">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============================ Band C: per-request fetch-rates ============================ -->
        <mxCell id="prov_fakerates" value="normal-rates&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;4 fixed raw rates,&lt;br&gt;deterministic (spec 8.1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="600" width="230" height="100" as="geometry" />
        </mxCell>

        <mxCell id="prov_fakenote" value="fake.clj also supports :malformed-rate&lt;br&gt;and :failure scenarios (exercised by&lt;br&gt;tests, spec 8.1) -- only :normal is&lt;br&gt;wired into the live app above." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="740" y="750" width="270" height="120" as="geometry" />
        </mxCell>

        <mxCell id="prov_ec_fake" value="fetch-rates(quote-request)&#10;[Calculation -- no I/O]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="prov_fakecarrier" target="prov_fakerates">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="prov_shippo_map_req" value="mapping/quote-request-&gt;shippo-request&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;[Calculation] address/parcel -&gt;&lt;br&gt;Shippo snake_case; kg-&gt;lb, cm-&gt;in,&lt;br&gt;decimal-&gt;2-decimal wire string&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1030" y="600" width="260" height="120" as="geometry" />
        </mxCell>

        <mxCell id="prov_shippo_client" value="client/fetch-shipment-rates&lt;br&gt;client.clj&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;[Action] real java.net.http.HttpClient&lt;br&gt;POST {base-url}/shipments/, explicit&lt;br&gt;connect + request timeouts (spec 8.2)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1330" y="590" width="270" height="130" as="geometry" />
        </mxCell>

        <mxCell id="prov_shippo_outcomedec" value="2xx&#10;response?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1640" y="605" width="160" height="100" as="geometry" />
        </mxCell>

        <mxCell id="prov_shippo_ok" value="mapping/shippo-response-&gt;raw-rates&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;[Calculation] object_id, provider,&lt;br&gt;servicelevel, amount -&gt; raw-rate&lt;br&gt;shape (surcharge always 0M,&lt;br&gt;available? always true)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1850" y="590" width="270" height="130" as="geometry" />
        </mxCell>

        <mxCell id="prov_shippo_classify" value="mapping/classify-failure&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;[Calculation] timeout -&gt; :timeout;&lt;br&gt;401/403 -&gt; :auth-failure;&lt;br&gt;400/422 -&gt; :validation-error;&lt;br&gt;429 -&gt; :rate-limited; else&lt;br&gt;(incl. connection failure) -&gt;&lt;br&gt;:upstream-error (safe default)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1850" y="750" width="270" height="160" as="geometry" />
        </mxCell>

        <mxCell id="prov_ec1" value="fetch-rates(quote-request)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="prov_shippocarrier" target="prov_shippo_map_req">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="prov_ec2" value="shippo request body" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="prov_shippo_map_req" target="prov_shippo_client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="prov_ec3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="prov_shippo_client" target="prov_shippo_outcomedec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="prov_ec4" value="yes -- parsed JSON body" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="prov_shippo_outcomedec" target="prov_shippo_ok">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="prov_ec5" value="no -- non-2xx status,&#10;timeout, or connection failure" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="prov_shippo_outcomedec" target="prov_shippo_classify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============================ Band D: shared contracts + return ============================ -->
        <mxCell id="prov_rawrate_contract" value="Shared raw-rate shape&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(parcelwise.domain.quote-engine's input,&lt;br&gt;spec 13.4): :id :carrier :service-code&lt;br&gt;:service-name :currency :base-amount&lt;br&gt;:surcharge-amount :total-amount&lt;br&gt;:estimated-days :available? -- both&lt;br&gt;adapters produce this identically.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="740" y="940" width="350" height="150" as="geometry" />
        </mxCell>

