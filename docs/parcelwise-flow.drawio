          <mxGeometry x="1850" y="1060" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="prov_returnref" value="Returns as protocol/fetch-rates's&lt;br&gt;result -- flows into the &quot;End-to-End&lt;br&gt;Quote Flow&quot; tab's ::carrier-result&lt;br&gt;/ :status? decision in&lt;br&gt;quotes.service/get-quotes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="2180" y="960" width="300" height="150" as="geometry" />
