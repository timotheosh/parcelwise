        <mxCell id="prov_eb4" value=":error key present" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="prov_adapterfactory" target="prov_startupfail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="prov_eb5" value=":provider :fake" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="prov_adapterfactory" target="prov_fakecarrier">
          <mxGeometry relative="1" as="geometry" />
