        <mxCell id="prov_ed2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;fontColor=#999999;" edge="1" parent="1" source="prov_shippo_ok" target="prov_rawrate_contract">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="prov_ed3" value=":rates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="prov_fakerates" target="prov_carrierresult_ok">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="prov_ed4" value=":rates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="prov_shippo_ok" target="prov_carrierresult_ok">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="prov_ed5" value=":error-type" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="prov_shippo_classify" target="prov_carrierresult_err">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="prov_ed6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;fontColor=#999999;" edge="1" parent="1" source="prov_carrierresult_ok" target="prov_returnref">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="prov_ed7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;fontColor=#999999;" edge="1" parent="1" source="prov_carrierresult_err" target="prov_returnref">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="prov_legend" value="Legend&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;green rectangle&lt;/b&gt; = pure calculation &amp;nbsp;|&amp;nbsp; &lt;b&gt;purple rectangle&lt;/b&gt; = action (I/O-touching) &amp;nbsp;|&amp;nbsp; &lt;b&gt;orange rectangle&lt;/b&gt; = CarrierAdapter implementation &amp;nbsp;|&amp;nbsp; &lt;b&gt;blue rounded&lt;/b&gt; = data/value&lt;br&gt;&lt;b&gt;yellow diamond&lt;/b&gt; = decision/branch &amp;nbsp;|&amp;nbsp; &lt;b&gt;red rounded&lt;/b&gt; = failure terminal (application fails to start) &amp;nbsp;|&amp;nbsp; &lt;b&gt;grey dashed box/lines&lt;/b&gt; = contract notes and cross-tab references (not a call edge)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
