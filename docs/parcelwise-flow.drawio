        <mxCell id="prov_ed1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;fontColor=#999999;" edge="1" parent="1" source="prov_fakerates" target="prov_rawrate_contract">
